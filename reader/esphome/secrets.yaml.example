# Copy to secrets.yaml (gitignored) and fill in.
#
#   cp secrets.yaml.example secrets.yaml
#   openssl rand -base64 32        # -> api_key

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# Fallback AP when the network is not reachable (captive portal).
ap_password: "fallback-ap-password"

# Native API encryption key, base64 of 32 bytes.
api_key: "REPLACE_ME_base64_32_bytes"

ota_password: "ota-password"

# web_server auth. Also guards the reader API, so the print spooler needs it.
web_username: "admin"
web_password: "web-password"
